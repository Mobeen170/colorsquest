# Keep CocoaPods aligned with the Runner and current plugin deployment target.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # flutter_soloud 3.5.4 builds as an embedded dynamic framework and uses
    # file metadata plus monotonic timers for app-contained audio playback.
    # Apple requires the framework bundle—not Runner or Flutter.framework—to
    # carry the matching required-reason declarations. Keep this app-owned
    # resource injection until the plugin publishes its own privacy manifest.
    next unless target.name == 'flutter_soloud'

    privacy_manifest_path = File.expand_path(
      'PrivacyManifests/flutter_soloud/PrivacyInfo.xcprivacy',
      __dir__,
    )
    unless File.file?(privacy_manifest_path)
      raise "Missing flutter_soloud privacy manifest: #{privacy_manifest_path}"
    end

    privacy_group = installer.pods_project.main_group.find_subpath(
      'Coloriboo Privacy Manifests',
      true,
    )
    privacy_reference = privacy_group.files.find do |file|
      File.expand_path(file.real_path.to_s) == privacy_manifest_path
    end
    privacy_reference ||= privacy_group.new_file(privacy_manifest_path)
    target.resources_build_phase.add_file_reference(privacy_reference, true)
  end
end
